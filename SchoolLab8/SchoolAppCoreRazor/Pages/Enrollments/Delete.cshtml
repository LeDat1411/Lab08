@page
@model SchoolAppCoreRazor.Pages.Enrollments.DeleteModel
@{
    ViewData["Title"] = "Delete Enrollment";
}

<h1>@ViewData["Title"]</h1>

<p>Delete this enrollment?</p>
<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.Enrollment.EnrollmentID</dd>
    <dt class="col-sm-3">Course</dt>
    <dd class="col-sm-9">@(Model.Enrollment.Course?.Title ?? Model.Enrollment.CourseID.ToString())</dd>
    <dt class="col-sm-3">Student</dt>
    <dd class="col-sm-9">@(Model.Enrollment.Student is { } student ? $"{student.FirstName} {student.LastName}" : Model.Enrollment.StudentID.ToString())</dd>
    <dt class="col-sm-3">Grade</dt>
    <dd class="col-sm-9">@Model.Enrollment.Grade</dd>
</dl>
<form asp-page="./Delete" asp-route-id="@Model.Enrollment.EnrollmentID" method="post">
    <button class="btn btn-danger" type="submit">Delete</button>
    <a asp-page="./Index" class="btn btn-link">Back to List</a>
</form>
