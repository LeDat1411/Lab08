@page
@model SchoolAppCoreRazor.Pages.Students.DeleteModel
@{
    ViewData["Title"] = "Delete Student";
}

<h1>@ViewData["Title"]</h1>

<p>Delete this student? Related records will also be deleted.</p>
<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.Student.StudentID</dd>
    <dt class="col-sm-3">Last Name</dt>
    <dd class="col-sm-9">@Model.Student.LastName</dd>
    <dt class="col-sm-3">First Name</dt>
    <dd class="col-sm-9">@Model.Student.FirstName</dd>
    <dt class="col-sm-3">Enrollment Date</dt>
    <dd class="col-sm-9">@Model.Student.EnrollmentDate.ToString("yyyy-MM-dd")</dd>
</dl>
<form asp-page="./Delete" asp-route-id="@Model.Student.StudentID" method="post">
    <button class="btn btn-danger" type="submit">Delete</button>
    <a asp-page="./Index" class="btn btn-link">Back to List</a>
</form>
