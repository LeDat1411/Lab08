@page
@model SchoolAppCoreRazor.Pages.Instructors.DeleteModel
@{
    ViewData["Title"] = "Delete Instructor";
}

<h1>@ViewData["Title"]</h1>

<p>Delete this instructor?</p>
<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.Instructor.InstructorID</dd>
    <dt class="col-sm-3">Last Name</dt>
    <dd class="col-sm-9">@Model.Instructor.LastName</dd>
    <dt class="col-sm-3">First Name</dt>
    <dd class="col-sm-9">@Model.Instructor.FirstName</dd>
    <dt class="col-sm-3">Hire Date</dt>
    <dd class="col-sm-9">@Model.Instructor.HireDate.ToString("yyyy-MM-dd")</dd>
</dl>
<form asp-page="./Delete" asp-route-id="@Model.Instructor.InstructorID" method="post">
    <button class="btn btn-danger" type="submit">Delete</button>
    <a asp-page="./Index" class="btn btn-link">Back to List</a>
</form>
