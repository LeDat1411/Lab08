@page
@model SchoolAppCoreRazor.Pages.Departments.DetailsModel
@{
    ViewData["Title"] = "Details Department";
}

<h1>@ViewData["Title"]</h1>

<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.Department.DepartmentID</dd>
    <dt class="col-sm-3">Department Name</dt>
    <dd class="col-sm-9">@Model.Department.DepartmentName</dd>
    <dt class="col-sm-3">Budget</dt>
    <dd class="col-sm-9">@Model.Department.Budget</dd>
    <dt class="col-sm-3">Start Date</dt>
    <dd class="col-sm-9">@Model.Department.StartDate.ToString("yyyy-MM-dd")</dd>
</dl>
<a asp-page="./Edit" asp-route-id="@Model.Department.DepartmentID" class="btn btn-primary">Edit</a>
<a asp-page="./Index" class="btn btn-link">Back to List</a>
