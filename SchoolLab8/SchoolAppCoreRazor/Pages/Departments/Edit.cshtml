@page
@model SchoolAppCoreRazor.Pages.Departments.EditModel
@{
    ViewData["Title"] = "Edit Department";
}

<h1>@ViewData["Title"]</h1>

<form asp-page="./Edit" asp-route-id="@Model.Department.DepartmentID" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Department.DepartmentID" />
    <div class="mb-3">
        <label asp-for="Department.DepartmentName" class="form-label"></label>
        <input asp-for="Department.DepartmentName" class="form-control" />
        <span asp-validation-for="Department.DepartmentName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Department.Budget" class="form-label"></label>
        <input asp-for="Department.Budget" class="form-control" />
        <span asp-validation-for="Department.Budget" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Department.StartDate" class="form-label"></label>
        <input asp-for="Department.StartDate" class="form-control" />
        <span asp-validation-for="Department.StartDate" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="./Index" class="btn btn-link">Back to List</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
