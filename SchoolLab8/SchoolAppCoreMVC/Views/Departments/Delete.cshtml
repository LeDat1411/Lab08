@model Department
@{
    ViewData["Title"] = "Delete Department";
}

<h1>@ViewData["Title"]</h1>

<p>Delete this department? Related records will also be deleted.</p>
<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.DepartmentID</dd>
    <dt class="col-sm-3">Department Name</dt>
    <dd class="col-sm-9">@Model.DepartmentName</dd>
    <dt class="col-sm-3">Budget</dt>
    <dd class="col-sm-9">@Model.Budget</dd>
    <dt class="col-sm-3">Start Date</dt>
    <dd class="col-sm-9">@Model.StartDate.ToString("yyyy-MM-dd")</dd>
</dl>
<form asp-action="Delete" asp-route-id="@Model.DepartmentID" method="post">
    <button class="btn btn-danger" type="submit">Delete</button>
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</form>
