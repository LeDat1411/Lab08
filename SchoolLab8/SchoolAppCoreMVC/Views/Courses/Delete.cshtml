@model Course
@{
    ViewData["Title"] = "Delete Course";
}

<h1>@ViewData["Title"]</h1>

<p>Delete this course? Related records will also be deleted.</p>
<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.CourseID</dd>
    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>
    <dt class="col-sm-3">Credits</dt>
    <dd class="col-sm-9">@Model.Credits</dd>
    <dt class="col-sm-3">Department</dt>
    <dd class="col-sm-9">@(Model.Department?.DepartmentName ?? Model.DepartmentID.ToString())</dd>
</dl>
<form asp-action="Delete" asp-route-id="@Model.CourseID" method="post">
    <button class="btn btn-danger" type="submit">Delete</button>
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</form>
