@model Student
@{
    ViewData["Title"] = "Details Student";
}

<h1>@ViewData["Title"]</h1>

<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.StudentID</dd>
    <dt class="col-sm-3">Last Name</dt>
    <dd class="col-sm-9">@Model.LastName</dd>
    <dt class="col-sm-3">First Name</dt>
    <dd class="col-sm-9">@Model.FirstName</dd>
    <dt class="col-sm-3">Enrollment Date</dt>
    <dd class="col-sm-9">@Model.EnrollmentDate.ToString("yyyy-MM-dd")</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.StudentID" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-link">Back to List</a>
